# PoochCare Environment Configuration Template
# Copy this file to .env and fill in your values
# DO NOT commit .env to git - use .env.example for team reference

# API Configuration
API_BASE_URL=https://dev-api.pooch.app
API_TIMEOUT_SECONDS=20

# Feature Flags
ENABLE_LOGGING=true
DEBUG_MODE=true

# API Keys (set these in your .env.production)
API_KEY=
FCM_SERVER_KEY=
